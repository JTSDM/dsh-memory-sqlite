{
  "name": "dsh-memory-sqlite",
  "version": "0.1.0",
  "description": "Native memory service layer for DeepSeek Harness: ctx.provide('memory') with SQLite local provider (content_hash idempotency + FTS5), async lifecycle engine, memorize/recall agent tools, and WorkBuddy file bridge (JSONL + sentinel-rendered MEMORY.md).",
  "author": "JTSDM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JTSDM/dsh-memory-sqlite.git"
  },
  "homepage": "https://github.com/JTSDM/dsh-memory-sqlite#readme",
  "bugs": {
    "url": "https://github.com/JTSDM/dsh-memory-sqlite/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-jobs": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "sqlite",
    "long-term-memory"
  ],
  "license": "MIT"
}
